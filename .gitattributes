# Every file in the working tree currently shows as modified because line
# endings differ between the index and the checkout (95 files, 22553
# insertions / 22553 deletions — pure CRLF churn). Normalising to LF makes
# real changes reviewable again.
#
# After committing this file, run once:
#   git add --renormalize .
#   git commit -m "chore: normalise line endings to LF"
* text=auto eol=lf

*.png  binary
*.webp binary
*.svg  text eol=lf
*.mp3  binary
*.ico  binary
