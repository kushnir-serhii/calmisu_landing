---
import { DownloadButtons } from "@/components/ui/DownloadButtons";

/**
 * The "Try the app" / "Find your center" promo box — used at the end of
 * about.astro and every blog post.
 */
interface Props {
  title: string;
  text: string;
  location: string;
  class?: string;
}

const { title, text, location, class: className = "" } = Astro.props;
---

<div class:list={["flex flex-col sm:flex-row sm:items-center justify-between gap-6 rounded-3xl bg-brand-100 p-8 sm:p-10", className]}>
  <div class="flex flex-col gap-2">
    <p class="text-foreground font-display text-xl sm:text-2xl font-normal leading-[120%]">
      {title}
    </p>
    <p class="text-muted-foreground font-body text-sm sm:text-base max-w-[380px]">
      {text}
    </p>
  </div>
  <DownloadButtons
    client:load
    only="android"
    location={location}
    widthClass="w-full sm:w-auto"
    className="shrink-0"
  />
</div>
