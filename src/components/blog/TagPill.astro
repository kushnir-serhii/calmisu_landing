---
/**
 * The small brand pill used for a post's primary tag — on cards (optionally
 * absolutely positioned over the thumbnail) and on the post page itself.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span class:list={["text-brand font-body text-xs px-3 py-1 rounded-full bg-brand-100", className]}>
  <slot />
</span>
