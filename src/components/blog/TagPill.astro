---
/**
 * The small brand pill used for a post's primary tag — on cards (optionally
 * absolutely positioned over the thumbnail) and on the post page itself.
 */
import { badgeVariants } from "@/components/ui/badge";
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span class={cn(badgeVariants({ size: "sm" }), className)}>
  <slot />
</span>
