---
import HeroCTA from "./HeroCTA";
---

<section
  data-hero
  class="flex flex-col items-center pt-10 sm:pt-12 md:pt-16 px-6 sm:px-8 md:px-[140px] gap-8 md:gap-10 overflow-hidden"
>
  <!-- Content -->
  <div class="flex flex-col items-center gap-4 md:gap-5 w-full max-w-[1160px]">
    <div class="flex flex-col items-center gap-3 sm:gap-4 w-full">
      <!-- Pill -->
      <div class="flex py-2 sm:py-3 px-3 sm:px-4 justify-center items-center gap-1 rounded-full bg-brand-100">
        <div class="flex p-1 items-center rounded-full bg-brand-200 motion-safe:animate-[pulse_3s_ease-in-out_infinite]">
          <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
            <circle cx="4" cy="4" r="4" fill="hsl(var(--brand-blue))"></circle>
          </svg>
        </div>
        <span class="text-brand-dark font-body text-base sm:text-lg font-normal leading-[150%]">
          early access
        </span>
      </div>
      <!-- Heading -->
      <h1 class="text-foreground text-center font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-[80px] font-normal leading-[90%] my-[4px]">
        Calm the storm.
        <br />
        Find your center.
      </h1>
    </div>
    <p class="max-w-[737px] text-foreground text-center font-body text-base sm:text-lg font-light leading-[150%] px-[24px]">
      Calmisu guides you through anxiety with a structured calming flow —
      breathing, grounding, calligraphy, and meditation — each step
      deepening the last.
    </p>
  </div>

  <div class="flex flex-col items-center gap-3">
    <!-- Buttons are server-rendered; they only need JS to react to clicks, so
         hydrate once the main thread is idle instead of on load. -->
    <HeroCTA client:idle />
    <p class="text-muted-foreground text-center font-body text-sm font-light leading-[140%]">
      Free · No ads · No account needed
    </p>
  </div>

  <!-- Hero images -->
  <!-- The container already reserves space via aspect-[1440/855], so
       width/height here are the true intrinsic sizes, not layout hints. -->
  <div class="relative w-screen aspect-[1440/855] mt-0">
    <img
      src="/images/hero-sky.webp"
      alt=""
      width="1440"
      height="736"
      class="absolute w-[100.5%] left-[-0.3%] bottom-0 object-cover"
      loading="eager"
    />
    <img
      data-hero-phone
      src="/images/hero-app.webp"
      alt="Calmisu anxiety app showing the guided breathing screen"
      width="1440"
      height="858"
      class="absolute w-full left-0 bottom-[5%] object-contain will-change-transform"
      loading="eager"
      fetchpriority="high"
    />
    <img
      data-hero-cloud
      src="/images/cloud-small.webp"
      alt=""
      width="1187"
      height="747"
      class="absolute w-2/3 bottom-0 lg:bottom-[10%] object-contain will-change-transform left-0 right-0 mx-auto z-10"
      loading="lazy"
    />
  </div>
</section>

<script>
  // Parallax — plain DOM, so it doesn't pull React into the critical chain.
  const section = document.querySelector<HTMLElement>("[data-hero]");
  const phone = document.querySelector<HTMLElement>("[data-hero-phone]");
  const cloud = document.querySelector<HTMLElement>("[data-hero-cloud]");

  if (section) {
    // Parallax is spatial motion, so it stays off (and layers rest in place)
    // whenever the visitor asks for reduced motion — including mid-session.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;

    // Writes transforms straight to the DOM, batched to one rAF per frame,
    // so the layers never lag a scroll event behind (mirrors ChatSection).
    const apply = () => {
      frame = 0;
      if (reduceMotion.matches) {
        if (phone) phone.style.transform = "";
        if (cloud) cloud.style.transform = "";
        return;
      }
      const scrollProgress = -section.getBoundingClientRect().top;
      if (phone) {
        phone.style.transform = `translateY(${scrollProgress * -0.08}px)`;
      }
      if (cloud) {
        cloud.style.transform = `translateY(${Math.max(0, scrollProgress * 0.25)}px)`;
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(apply);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    reduceMotion.addEventListener("change", schedule);
  }
</script>
