---
import { navLinks } from "@/data/navLinks";

// Static header: the only interactive part is the mobile menu toggle, handled
// by the small script below, so no React ships for it.
const currentPath = Astro.url.pathname;
const isLinkActive = (href: string) => {
  if (href.includes("#")) return false;
  const linkPath = href.split("?")[0];
  return (
    currentPath === linkPath ||
    (linkPath !== "/" && currentPath.startsWith(linkPath))
  );
};

interface Props {
  /**
   * Reserves the quiz's progress rail along the header's bottom edge. The
   * rail has to live here rather than in QuizIsland because it needs to
   * scroll-lock with the header, and the header is the only sticky element
   * on the page — see src/pages/quiz.astro.
   */
  progress?: boolean;
}
const { progress = false } = Astro.props;
---

<header
  data-site-header
  class="flex w-full px-6 md:px-10 lg:px-[120px] py-4 justify-between items-center border-b border-secondary bg-background sticky top-0 z-50"
>
  <a href="/" class="flex items-center gap-2" aria-label="Calmisu home">
    <img src="public/images/logo_cloud_calmisu_96x2.webp" width="36" height="36" alt="">
    <p class="font-display text-[29px] text-foreground">Calmisu</p>
  </a>

  <!-- Desktop nav -->
  <nav class="hidden lg:flex items-center gap-6 xl:gap-16" aria-label="Main">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          target={link.isExternal ? "_blank" : undefined}
          rel={link.isExternal ? "noopener noreferrer" : undefined}
          aria-current={isLinkActive(link.href) ? "page" : undefined}
          class:list={[
            "text-center font-body text-base xl:text-xl font-normal leading-[150%] whitespace-nowrap hover:text-brand-dark transition-colors",
            isLinkActive(link.href) ? "text-brand-dark" : "text-foreground",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <!-- Mobile hamburger -->
  <button
    type="button"
    data-menu-toggle
    class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg touch-manipulation"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <!-- lucide "menu" -->
    <svg data-icon-open xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="4" x2="20" y1="12" y2="12"></line>
      <line x1="4" x2="20" y1="6" y2="6"></line>
      <line x1="4" x2="20" y1="18" y2="18"></line>
    </svg>
    <!-- lucide "x" -->
    <svg data-icon-close class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    data-menu
    class="hidden fixed inset-0 top-[var(--header-h,61px)] z-40 bg-background lg:hidden animate-in fade-in slide-in-from-top-2 duration-200"
  >
    <nav class="flex flex-col items-center gap-2 pt-6 px-5" aria-label="Main mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            target={link.isExternal ? "_blank" : undefined}
            rel={link.isExternal ? "noopener noreferrer" : undefined}
            aria-current={isLinkActive(link.href) ? "page" : undefined}
            class:list={[
              "w-full text-center py-4 font-body text-xl font-normal leading-[150%] transition-colors rounded-xl hover:bg-muted active:bg-muted hover:text-brand-dark",
              isLinkActive(link.href) ? "text-brand-dark" : "text-foreground",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  {
    progress && (
      <div
        data-quiz-progress
        class="absolute left-0 right-0 -bottom-px h-[3px] bg-brand-100"
        role="progressbar"
        aria-valuemin="1"
        aria-valuemax="9"
        aria-valuenow="1"
      >
        <div
          class="h-full bg-brand transition-[width] duration-300 ease-out"
          style="width: var(--quiz-progress, 0%)"
        />
      </div>
    )
  }
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = header?.querySelector<HTMLElement>("[data-menu]");
  const iconOpen = header?.querySelector("[data-icon-open]");
  const iconClose = header?.querySelector("[data-icon-close]");

  // The mobile drawer sits under the header, so it needs the header's real
  // rendered height (which differs by breakpoint) rather than a hardcoded
  // value — see src/pages/quiz.astro, which sets the same variable the same way.
  function setHeaderHeightVar() {
    if (header) {
      document.documentElement.style.setProperty(
        "--header-h",
        header.offsetHeight + "px"
      );
    }
  }
  setHeaderHeightVar();
  window.addEventListener("load", setHeaderHeightVar);
  window.addEventListener("resize", setHeaderHeightVar);

  if (toggle && menu) {
    const setOpen = (open: boolean, returnFocus = false) => {
      menu.classList.toggle("hidden", !open);
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      // Lock body scroll while the drawer is open
      document.body.style.overflow = open ? "hidden" : "";
      if (open) {
        menu.querySelector<HTMLAnchorElement>("a")?.focus();
      } else if (returnFocus) {
        toggle.focus();
      }
    };

    toggle.addEventListener("click", () =>
      setOpen(menu.classList.contains("hidden"))
    );
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false))
    );
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false, true);
      }
    });
  }
</script>
