---
/**
 * Contextual quiz CTA, rendered after a blog post's body.
 *
 * Pure markup — no island, so it adds nothing to the page's JS. The variant
 * is chosen by the caller from the post's `tags` (see the tag→variant map
 * in blog/[...slug].astro); copy is CONTENT.md §7 verbatim.
 */
import { brandButtonClass } from "@/components/ui/BrandButton";

export type QuizCTAVariant = "panic" | "anxiety" | "racingThoughts" | "sleep" | "default";

interface Props {
  variant: QuizCTAVariant;
  src: string;
}

const COPY: Record<QuizCTAVariant, { line: string; button: string }> = {
  panic: {
    line: "Panic follows a pattern. Find out which one yours follows, and the two techniques that work fastest on it.",
    button: "Find my pattern",
  },
  anxiety: {
    line: "There are four techniques here. Find out which two fit the way your anxiety actually shows up.",
    button: "Find my two",
  },
  racingThoughts: {
    line: "For minds that will not stop looping — find the technique that gives your attention somewhere else to be.",
    button: "Find my pattern",
  },
  sleep: {
    line: "Find out what your evenings are actually doing, and build the routine that fits your day.",
    button: "Build my routine",
  },
  default: {
    line: "Find out which pattern your anxiety follows, and the two techniques that work fastest for it.",
    button: "Take the quiz",
  },
};

const { variant, src } = Astro.props;
const { line, button } = COPY[variant];
---

<div
  class="flex flex-col items-center gap-4 w-full rounded-3xl bg-brand-100 px-6 sm:px-10 py-10 sm:py-12 text-center"
>
  <h3 class="text-foreground font-display text-2xl sm:text-3xl font-normal leading-[110%]">
    Two minutes, nine questions
  </h3>

  <p class="max-w-[480px] text-foreground font-body text-base font-light leading-[150%]">
    {line}
  </p>

  <a
    href={`/quiz/?src=${src}`}
    class={brandButtonClass({ className: "no-underline" })}
  >
    {button}
  </a>

  <p class="text-muted-foreground font-body text-sm font-light">
    Free · No account needed
  </p>
</div>
