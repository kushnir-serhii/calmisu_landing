---
import "@/index.css";
import { CookieConsent } from "@/components/CookieConsent";

interface Props {
  /** Full <title> — no site-name suffix is appended automatically. */
  title: string;
  description: string;
  /** Absolute or root-relative. Defaults to /images/calmisuog.png */
  ogImage?: string;
  /** Defaults to Astro.url.href */
  canonicalUrl?: string;
  ogType?: "website" | "article";
  /** <html lang>. Defaults to "en". Localized pages pass their own. */
  lang?: string;
  /**
   * Emit <meta name="robots" content="noindex, nofollow"> for utility pages
   * that must stay out of search results.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "/images/calmisuog.png",
  canonicalUrl,
  ogType = "website",
  lang = "en",
  noindex = false,
} = Astro.props;

const canonical = canonicalUrl ?? Astro.url.href;
// Social crawlers reject relative image paths — always emit an absolute URL.
const absoluteOgImage = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, LinkedIn, Slack, Discord, iMessage previews) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: preconnect first so the TLS handshake overlaps the CSS parse. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Orienta&family=Roboto:wght@300;400;500;700&display=swap"
    />

    <!--
      Per-page <head> injection point. Pages pass extra <meta>/<link> tags
      via <Fragment slot="head"> — used for OG article timestamps and
      hreflang alternates on the localized legal pages.
    -->
    <slot name="head" />
  </head>

  <body>
    <slot />
    <CookieConsent client:load />
  </body>
</html>
