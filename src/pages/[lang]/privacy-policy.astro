---
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer";
import LocalizedDocPage from "@/components/legal/LocalizedDocPage.astro";
import { LanguageSwitcher } from "@/components/legal/LanguageSwitcher";
import { PrivacyEn } from "@/components/legal/calmisu/Privacy.en";
import { PrivacyPl } from "@/components/legal/calmisu/Privacy.pl";
import { PrivacyUa } from "@/components/legal/calmisu/Privacy.ua";
import { CALMISU_LANGS as LANGS, langStaticPaths, resolveLang } from "@/lib/i18n";

export function getStaticPaths() {
  return langStaticPaths(LANGS);
}

const { lang } = Astro.params;

const content = { en: PrivacyEn, pl: PrivacyPl, uk: PrivacyUa };
const current = resolveLang(lang, content);
const Content = content[current];

const meta = {
  en: {
    title: "Privacy Policy — Calmisu",
    description:
      "Read how Calmisu collects, uses, and protects your information across the app.",
  },
  pl: {
    title: "Polityka Prywatności — Calmisu",
    description:
      "Dowiedz się, jak Calmisu zbiera, wykorzystuje i chroni Twoje informacje w aplikacji.",
  },
  uk: {
    title: "Політика Конфіденційності — Calmisu",
    description:
      "Дізнайтеся, як Calmisu збирає, використовує та захищає вашу інформацію в додатку.",
  },
}[current];
---

<LocalizedDocPage meta={meta} lang={current} langs={LANGS} path="privacy-policy">
  <Header slot="before-main" />

  <div class="ml-auto mt-10" slot="nav">
    <LanguageSwitcher lang={current} langs={LANGS} currentPath={Astro.url.pathname} client:load />
  </div>

  <Content />

  <Footer slot="after-main" />
</LocalizedDocPage>
