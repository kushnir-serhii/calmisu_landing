---
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer";
import LocalizedDocPage from "@/components/legal/LocalizedDocPage.astro";
import { LanguageSwitcher } from "@/components/legal/LanguageSwitcher";
import { TermsEn } from "@/components/legal/calmisu/Terms.en";
import { TermsPl } from "@/components/legal/calmisu/Terms.pl";
import { TermsUa } from "@/components/legal/calmisu/Terms.ua";
import { CALMISU_LANGS as LANGS, langStaticPaths, resolveLang } from "@/lib/i18n";

export function getStaticPaths() {
  return langStaticPaths(LANGS);
}

const { lang } = Astro.params;

const content = { en: TermsEn, pl: TermsPl, uk: TermsUa };
const current = resolveLang(lang, content);
const Content = content[current];

const meta = {
  en: {
    title: "Terms of Service — Calmisu",
    description: "Read the terms and conditions for using the Calmisu app.",
  },
  pl: {
    title: "Warunki Korzystania — Calmisu",
    description: "Zapoznaj się z warunkami korzystania z aplikacji Calmisu.",
  },
  uk: {
    title: "Умови Використання — Calmisu",
    description: "Ознайомтеся з умовами використання додатку Calmisu.",
  },
}[current];
---

<LocalizedDocPage meta={meta} lang={current} langs={LANGS} path="terms-of-service">
  <Header slot="before-main" />

  <div class="ml-auto mt-10" slot="nav">
    <LanguageSwitcher lang={current} langs={LANGS} currentPath={Astro.url.pathname} client:load />
  </div>

  <Content />

  <Footer slot="after-main" />
</LocalizedDocPage>
