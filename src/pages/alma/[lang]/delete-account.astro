---
import AlmaDocsNav from "@/components/legal/alma/AlmaDocsNav.astro";
import LocalizedDocPage from "@/components/legal/LocalizedDocPage.astro";
import { DeleteAccountEn } from "@/components/legal/alma/DeleteAccount.en";
import { DeleteAccountEs } from "@/components/legal/alma/DeleteAccount.es";
import { DeleteAccountUk } from "@/components/legal/alma/DeleteAccount.uk";
import { ALMA_LANGS as LANGS, langStaticPaths, resolveLang } from "@/lib/i18n";

export function getStaticPaths() {
  return langStaticPaths(LANGS);
}

const { lang } = Astro.params;

const content = { en: DeleteAccountEn, es: DeleteAccountEs, uk: DeleteAccountUk };
const current = resolveLang(lang, content);
const Content = content[current];

const meta = {
  en: {
    title: "Delete Your Alma Account",
    description: "Permanently delete your Alma account and all associated data.",
  },
  es: {
    title: "Eliminar tu Cuenta de Alma",
    description: "Elimina permanentemente tu cuenta de Alma y todos los datos asociados.",
  },
  uk: {
    title: "Видалення Акаунта Alma",
    description: "Остаточно видаліть свій акаунт Alma та всі пов'язані з ним дані.",
  },
}[current];
---

<LocalizedDocPage meta={meta} lang={current} langs={LANGS} path="delete-account" basePath="/alma" noindexFollow wrapContent={false}>
  <AlmaDocsNav slot="nav" lang={current} current="delete-account" currentPath={Astro.url.pathname} />

  <Content />
</LocalizedDocPage>
