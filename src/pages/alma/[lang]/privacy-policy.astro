---
import AlmaDocsNav from "@/components/legal/alma/AlmaDocsNav.astro";
import LocalizedDocPage from "@/components/legal/LocalizedDocPage.astro";
import { PrivacyPolicyEn } from "@/components/legal/alma/PrivacyPolicy.en";
import { PrivacyPolicyEs } from "@/components/legal/alma/PrivacyPolicy.es";
import { PrivacyPolicyUk } from "@/components/legal/alma/PrivacyPolicy.uk";
import { ALMA_LANGS as LANGS, langStaticPaths, resolveLang } from "@/lib/i18n";

export function getStaticPaths() {
  return langStaticPaths(LANGS);
}

const { lang } = Astro.params;

const content = { en: PrivacyPolicyEn, es: PrivacyPolicyEs, uk: PrivacyPolicyUk };
const current = resolveLang(lang, content);
const Content = content[current];

const meta = {
  en: {
    title: "Privacy Policy — Alma",
    description:
      "Read how the Alma app collects, uses, and protects your information.",
  },
  es: {
    title: "Política de Privacidad — Alma",
    description:
      "Descubre cómo la app Alma recopila, utiliza y protege tu información.",
  },
  uk: {
    title: "Політика Конфіденційності — Alma",
    description:
      "Дізнайтеся, як застосунок Alma збирає, використовує та захищає вашу інформацію.",
  },
}[current];
---

<LocalizedDocPage meta={meta} lang={current} langs={LANGS} path="privacy-policy" basePath="/alma" noindexFollow>
  <AlmaDocsNav slot="nav" lang={current} current="privacy-policy" currentPath={Astro.url.pathname} />

  <Content />
</LocalizedDocPage>
