---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AlmaDocsNav from "@/components/alma/AlmaDocsNav.astro";
import { PrivacyPolicyEn } from "@/components/alma/PrivacyPolicy.en";
import { PrivacyPolicyEs } from "@/components/alma/PrivacyPolicy.es";
import { PrivacyPolicyUk } from "@/components/alma/PrivacyPolicy.uk";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "uk" } },
  ];
}

const { lang } = Astro.params;

const content = { en: PrivacyPolicyEn, es: PrivacyPolicyEs, uk: PrivacyPolicyUk };
const current = (content[lang as keyof typeof content] ? lang : "en") as keyof typeof content;
const Content = content[current];

const meta = {
  en: {
    title: "Privacy Policy — Alma",
    description:
      "Read how the Alma app collects, uses, and protects your information.",
  },
  es: {
    title: "Política de Privacidad — Alma",
    description:
      "Descubre cómo la app Alma recopila, utiliza y protege tu información.",
  },
  uk: {
    title: "Політика Конфіденційності — Alma",
    description:
      "Дізнайтеся, як застосунок Alma збирає, використовує та захищає вашу інформацію.",
  },
}[current];

// hreflang alternates. The URL segment doubles as the ISO 639-1 code for all
// three languages (en / es / uk), so no mapping table is needed. Hrefs keep the
// trailing slash to match the canonical Astro emits for directory-format pages.
const alternates = ["en", "es", "uk"].map((l) => ({
  hreflang: l,
  href: new URL(`/alma/${l}/privacy-policy/`, Astro.site).href,
}));
const xDefault = new URL("/alma/en/privacy-policy/", Astro.site).href;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalUrl={Astro.url.href}
  lang={current}
>
  <Fragment slot="head">
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefault} />
  </Fragment>

  <div class="flex flex-col px-2 lg:px-36">
    <AlmaDocsNav lang={current} current="privacy-policy" currentPath={Astro.url.pathname} />
    <div>
      <Content />
    </div>
  </div>
</BaseLayout>
