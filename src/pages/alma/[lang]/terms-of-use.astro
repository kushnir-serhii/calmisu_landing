---
import AlmaDocsNav from "@/components/legal/alma/AlmaDocsNav.astro";
import LocalizedDocPage from "@/components/legal/LocalizedDocPage.astro";
import { TermsOfUseEn } from "@/components/legal/alma/TermsOfUse.en";
import { TermsOfUseEs } from "@/components/legal/alma/TermsOfUse.es";
import { TermsOfUseUk } from "@/components/legal/alma/TermsOfUse.uk";
import { ALMA_LANGS as LANGS, langStaticPaths, resolveLang } from "@/lib/i18n";

export function getStaticPaths() {
  return langStaticPaths(LANGS);
}

const { lang } = Astro.params;

const content = { en: TermsOfUseEn, es: TermsOfUseEs, uk: TermsOfUseUk };
const current = resolveLang(lang, content);
const Content = content[current];

const meta = {
  en: {
    title: "Terms of Use — Alma",
    description: "Read the terms of use for the Alma app.",
  },
  es: {
    title: "Términos de Uso — Alma",
    description: "Lee los términos de uso de la app Alma.",
  },
  uk: {
    title: "Умови Використання — Alma",
    description: "Ознайомтеся з умовами використання застосунку Alma.",
  },
}[current];
---

<LocalizedDocPage meta={meta} lang={current} langs={LANGS} path="terms-of-use" basePath="/alma" noindexFollow>
  <AlmaDocsNav slot="nav" lang={current} current="terms-of-use" currentPath={Astro.url.pathname} />

  <Content />
</LocalizedDocPage>
