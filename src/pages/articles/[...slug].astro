---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("articles", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, image, imageAlt, tags } =
  entry.data;
const { Content } = await entry.render();

const pageTitle = `${title} — Calmisu`;
const canonicalUrl = new URL(`/articles/${entry.slug}/`, Astro.site).href;
const ogImage = image ?? "/images/calmisuog.png";
const absoluteImage = new URL(ogImage, Astro.site).href;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  image: absoluteImage,
  author: {
    "@type": "Organization",
    name: "Calmisu",
  },
  publisher: {
    "@type": "Organization",
    name: "Calmisu",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", Astro.site).href,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
};
---

<BaseLayout
  title={pageTitle}
  description={description}
  ogImage={ogImage}
  ogType="article"
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
  </Fragment>

  {
    /*
      JSON-LD sits in <body>; Google's structured-data parser accepts it
      regardless of location.
    */
  }
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="w-full flex flex-col items-center px-6 sm:px-8 md:px-[140px] py-16 sm:py-20 md:py-24">
    <article class="flex flex-col gap-6 w-full max-w-[760px]">
      <header class="flex flex-col gap-4">
        <a
          href="/articles/"
          class="text-brand font-body text-sm no-underline hover:underline w-fit"
        >
          &larr; All articles
        </a>
        <h1 class="text-foreground font-display text-4xl sm:text-5xl font-normal leading-[105%]">
          {title}
        </h1>
        <div class="flex flex-wrap items-center gap-3">
          <time
            datetime={pubDate.toISOString()}
            class="text-muted-foreground font-body text-sm"
          >
            {dateFormatter.format(pubDate)}
          </time>
          {
            updatedDate && (
              <span class="text-muted-foreground font-body text-sm">
                (updated {dateFormatter.format(updatedDate)})
              </span>
            )
          }
        </div>
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="text-brand font-body text-xs px-3 py-1 rounded-full bg-brand-100">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </header>

      {
        image && (
          <img
            src={image}
            alt={imageAlt ?? ""}
            class="w-full aspect-[16/9] object-cover rounded-2xl"
          />
        )
      }

      <div class="article-prose prose max-w-none">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  /*
   * @tailwindcss/typography is a devDependency but is NOT currently
   * registered in tailwind.config.ts (owned by task-01/task-06), so the
   * `prose` class above has no effect yet. This scoped stylesheet gives
   * article bodies correct brand typography and a readable measure
   * independent of that plugin. If the plugin is registered later, these
   * rules layer on top harmlessly.
   */
  .article-prose {
    color: hsl(var(--foreground));
    font-family: "Roboto", sans-serif;
    font-weight: 300;
    line-height: 1.7;
    font-size: 1.0625rem;
  }

  .article-prose :global(h2) {
    font-family: "Orienta", sans-serif;
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.2;
    color: hsl(var(--foreground));
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .article-prose :global(h3) {
    font-family: "Orienta", sans-serif;
    font-weight: 400;
    font-size: 1.375rem;
    line-height: 1.25;
    color: hsl(var(--foreground));
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .article-prose :global(p) {
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin-top: 0;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-prose :global(ul) {
    list-style-type: disc;
  }

  .article-prose :global(ol) {
    list-style-type: decimal;
  }

  .article-prose :global(li) {
    padding-left: 0.25rem;
  }

  .article-prose :global(li > p) {
    margin-bottom: 0;
  }

  .article-prose :global(strong) {
    font-weight: 500;
    color: hsl(var(--foreground));
  }

  .article-prose :global(a) {
    color: hsl(var(--brand-blue));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-prose :global(a:hover) {
    opacity: 0.85;
  }
</style>
