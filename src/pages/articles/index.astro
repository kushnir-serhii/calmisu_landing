---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const articles = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Articles — Calmisu"
  description="Practical, calm guidance on breathing, grounding, and anxiety relief from the Calmisu team."
>
  <main class="w-full flex flex-col items-center px-6 sm:px-8 md:px-[140px] py-16 sm:py-20 md:py-24">
    <div class="flex flex-col items-center gap-3 w-full max-w-[737px] text-center mb-12 md:mb-16">
      <h1 class="text-foreground font-display text-4xl sm:text-5xl md:text-6xl font-normal leading-[100%]">
        Articles
      </h1>
      <p class="text-foreground font-body text-base sm:text-lg font-light leading-[150%]">
        Practical guidance on breathing, grounding, and calming techniques —
        written to help you understand and manage anxiety day to day.
      </p>
    </div>

    {
      articles.length === 0 ? (
        <p class="text-muted-foreground font-body text-base">
          No articles yet — check back soon.
        </p>
      ) : (
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 w-full max-w-[1160px] list-none p-0 m-0">
          {articles.map((article) => (
            <li>
              <a
                href={`/articles/${article.slug}/`}
                class="flex flex-col gap-4 h-full rounded-2xl bg-secondary/40 hover:bg-secondary/70 transition-colors p-6 sm:p-8 no-underline"
              >
                {article.data.image && (
                  <img
                    src={article.data.image}
                    alt={article.data.imageAlt ?? ""}
                    class="w-full aspect-[16/9] object-cover rounded-xl"
                    loading="lazy"
                  />
                )}
                <div class="flex flex-col gap-2">
                  <time
                    datetime={article.data.pubDate.toISOString()}
                    class="text-muted-foreground font-body text-sm"
                  >
                    {dateFormatter.format(article.data.pubDate)}
                  </time>
                  <h2 class="text-foreground font-display text-2xl sm:text-3xl font-normal leading-[120%]">
                    {article.data.title}
                  </h2>
                  <p class="text-foreground font-body text-base font-light leading-[150%]">
                    {article.data.description}
                  </p>
                  {article.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mt-2">
                      {article.data.tags.map((tag) => (
                        <span class="text-brand font-body text-xs px-3 py-1 rounded-full bg-brand-100">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
