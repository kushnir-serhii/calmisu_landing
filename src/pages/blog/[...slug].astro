---
import { getCollection, type CollectionEntry } from "astro:content";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer";
import TagPill from "@/components/blog/TagPill.astro";
import AppPromoCard from "@/components/blog/AppPromoCard.astro";
import QuizTeaser from "@/components/blog/QuizTeaser.astro";
import FAQAccordion from "@/components/ui/FAQAccordion";
import { splitAtHeading } from "@/lib/splitAtHeading";

export async function getStaticPaths() {
  const entries = await getCollection("blog", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  image,
  imageAlt,
  tags,
  authorName,
  authorBio,
  faq,
  quizCta,
} = entry.data;
const { Content } = await entry.render();

// dateModified defaults to the publish date when the post has never been edited.
const modifiedDate = updatedDate ?? pubDate;
// Byline avatar. Keep in sync with AUTHOR_IMAGE in src/pages/index.astro.
const authorImage = "/images/blog/blog_avatar_julia.webp";

// Mid-article quiz teaser (opt-in via frontmatter `quizCta` — see
// content/config.ts and QuizTeaser.astro). Only posts that opt in pay the
// cost of getting the body's rendered HTML string, since it's the one part
// of this page that isn't already static markup.
let teaserSplit: { before: string; after: string } | null = null;
if (quizCta) {
  // `type: "content"` collections are emulated over the glob loader in
  // Astro 5, which populates `entry.rendered.html` — cheaper than a second
  // render pass. Fall back to the Container API for older cached data or
  // any collection shape where that isn't populated.
  let bodyHtml = entry.rendered?.html;
  if (!bodyHtml) {
    const container = await AstroContainer.create();
    bodyHtml = await container.renderToString(Content);
  }
  // Before the 3rd <h2> — i.e. after two full sections. Posts with fewer
  // than three land the teaser before their last section instead.
  teaserSplit = splitAtHeading(bodyHtml, 3);
}

const pageTitle = `${title} — Calmisu`;
const canonicalUrl = new URL(`/blog/${entry.slug}/`, Astro.site).href;
const ogImage = image ?? "/images/calmisuog.png";
const absoluteImage = new URL(ogImage, Astro.site).href;

// Rough estimate from the raw markdown source — good enough for a "min read" hint.
const wordCount = entry.body.trim().split(/\s+/).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: modifiedDate.toISOString(),
  image: absoluteImage,
  author: {
    "@type": "Person",
    "@id": new URL("/#author", Astro.site).href,
    name: "Julia K",
    url: new URL("/about/", Astro.site).href,
    image: new URL("/images/blog/blog_avatar_julia.webp", Astro.site).href,
  },
  publisher: {
    "@type": "Organization",
    name: "Calmisu",
    url: new URL("/", Astro.site).href,
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", Astro.site).href,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
};

// Same pattern as the homepage (src/data/faq.ts): the frontmatter `faq`
// array is the single source for both the rendered accordion and this
// JSON-LD, so they can't drift out of sync.
const faqJsonLd = faq && faq.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }
  : null;
---

<BaseLayout
  title={pageTitle}
  description={description}
  ogImage={ogImage}
  ogType="article"
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
  </Fragment>

  {
    /*
      JSON-LD sits in <body>; Google's structured-data parser accepts it
      regardless of location.
    */
  }
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  )}

  <div class="flex flex-col items-center w-full bg-brand-beige overflow-hidden">
    <Header />

    <div class="w-full flex flex-col items-center px-6 sm:px-8 pt-10 sm:pt-14 pb-16 sm:pb-20">
      <div class="w-full max-w-[760px]">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 text-foreground font-body text-sm font-semibold no-underline hover:text-brand transition-colors mb-8"
        >
          &larr; All posts
        </a>

        <div class="flex flex-wrap items-center gap-3 mb-4">
          {tags[0] && <TagPill>{tags[0]}</TagPill>}
          <span class="text-muted-foreground font-body text-sm">
            {readMinutes} min read
          </span>
        </div>

        <h1 class="text-foreground font-display text-4xl sm:text-5xl md:text-6xl font-normal leading-[105%] mb-6">
          {title}
        </h1>

        <time
          datetime={pubDate.toISOString()}
          class="block text-muted-foreground font-body text-sm"
        >
          {dateFormatter.format(pubDate)}
          {updatedDate && ` (updated ${dateFormatter.format(updatedDate)})`}
        </time>

        <a
          href="/about/"
          class="mt-5 inline-flex items-center gap-3 no-underline group w-fit"
          rel="author"
        >
          <img
            src={authorImage}
            alt={authorName}
            width="36"
            height="36"
            loading="lazy"
            class="h-9 w-9 rounded-full object-cover bg-brand-100"
          />
          <span class="flex flex-col leading-tight">
            <span class="text-foreground font-body text-sm font-semibold group-hover:text-brand transition-colors">
              {authorName}
            </span>
            <span class="text-muted-foreground font-body text-xs">
              {authorBio}
            </span>
          </span>
        </a>
      </div>
    </div>

    <main class="w-full flex flex-col items-center px-6 sm:px-8 py-12 sm:py-16">
      <article class="flex flex-col gap-10 w-full max-w-[760px]">
        <div class="relative w-full aspect-[16/8] rounded-2xl overflow-hidden bg-muted -mt-16 sm:-mt-20">
          {image && (
            <img
              src={image}
              alt={imageAlt ?? ""}
              class="w-full h-full object-cover"
            />
          )}
        </div>

        <div class="article-prose prose max-w-none">
          {teaserSplit ? (
            <>
              <Fragment set:html={teaserSplit.before} />
              <QuizTeaser variant={quizCta!} src={`blog_${entry.slug}`} />
              <Fragment set:html={teaserSplit.after} />
            </>
          ) : (
            <Content />
          )}

          {faq && faq.length > 0 && (
            <>
              <h2>FAQ</h2>
              <FAQAccordion items={faq} client:visible />
            </>
          )}
        </div>

        <AppPromoCard
          title="Find your center with Calmisu."
          text="Guided breathing, grounding, calligraphy, and meditation — free to download."
          location="blog_cta"
        />
      </article>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  /*
   * @tailwindcss/typography is a devDependency but is NOT currently
   * registered in tailwind.config.ts (owned by task-01/task-06), so the
   * `prose` class above has no effect yet. This scoped stylesheet gives
   * article bodies correct brand typography and a readable measure
   * independent of that plugin. If the plugin is registered later, these
   * rules layer on top harmlessly.
   */
  /* Base .article-prose rules live in src/index.css (shared with
     about.astro); only this page's extras stay local. */

  .article-prose :global(h2) {
    font-family: "Orienta", sans-serif;
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.2;
    color: hsl(var(--foreground));
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .article-prose :global(h3) {
    font-family: "Orienta", sans-serif;
    font-weight: 400;
    font-size: 1.375rem;
    line-height: 1.25;
    color: hsl(var(--foreground));
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  /* Body rules skip anything inside a `.not-prose` island (the mid-article
     QuizTeaser): it sits inside .article-prose but carries its own type and
     colours, and on its dark panel the blue link colour below is unreadable.
     The typography plugin isn't registered, so `not-prose` only means
     something because of these :not() guards. */
  .article-prose :global(p:not(.not-prose *)) {
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin-top: 0;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-prose :global(ul) {
    list-style-type: disc;
  }

  .article-prose :global(ol) {
    list-style-type: decimal;
  }

  .article-prose :global(li) {
    padding-left: 0.25rem;
  }

  .article-prose :global(li > p) {
    margin-bottom: 0;
  }

  .article-prose :global(strong) {
    font-weight: 500;
    color: hsl(var(--foreground));
  }

  .article-prose :global(a:not(.not-prose *)) {
    color: hsl(var(--brand-blue-dark));
    text-decoration: none;
  }

  .article-prose :global(a:not(.not-prose *):hover) {
    opacity: 0.85;
  }

  /* Inline research citations: a blue, non-underlined link that reveals a
     concise dark tooltip on hover/focus instead of a separate "(Author,
     year)" parenthetical in the copy. Markdown posts author this raw HTML
     directly (see src/components/blog/Citation.astro for the component
     version and why the rules are duplicated there). */
  .article-prose :global(a.citation) {
    color: hsl(var(--brand-blue-dark));
    text-decoration: none;
    cursor: help;
    position: relative;
  }

  .article-prose :global(a.citation:hover) {
    opacity: 1;
  }

  .article-prose :global(a.citation::before),
  .article-prose :global(a.citation::after) {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease, visibility 0.15s ease;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
  }

  .article-prose :global(a.citation::after) {
    content: attr(data-tip);
    bottom: calc(100% + 8px);
    width: max-content;
    max-width: 260px;
    background: hsl(var(--foreground));
    color: hsl(var(--brand-beige));
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.4;
    text-align: left;
    white-space: normal;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
  }

  .article-prose :global(a.citation::before) {
    content: "";
    bottom: calc(100% + 3px);
    border: 5px solid transparent;
    border-top-color: hsl(var(--foreground));
  }

  .article-prose :global(a.citation:hover::before),
  .article-prose :global(a.citation:hover::after),
  .article-prose :global(a.citation:focus-visible::before),
  .article-prose :global(a.citation:focus-visible::after) {
    opacity: 1;
    visibility: visible;
  }

  /* Practice timeline: stage cards on a vertical rail. Dot color deepens
     from brand-blue-200 to foreground to show practice accumulating. */
  .article-prose :global(.practice-timeline) {
    margin: 2rem 0 2.25rem;
  }

  .article-prose :global(.practice-timeline ol) {
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.75rem;
  }

  .article-prose :global(.practice-timeline li) {
    --dot: hsl(var(--brand-blue-200));
    position: relative;
    margin-left: 1.75rem;
    padding: 1.25rem;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--brand-blue-100));
    border-radius: 20px;
  }

  .article-prose :global(.practice-timeline li:nth-child(2)) { --dot: hsl(var(--brand-blue-300)); }
  .article-prose :global(.practice-timeline li:nth-child(3)) { --dot: hsl(var(--brand-star)); }
  .article-prose :global(.practice-timeline li:nth-child(4)) { --dot: hsl(var(--brand-blue)); }
  .article-prose :global(.practice-timeline li:nth-child(5)) { --dot: hsl(var(--brand-blue-dark)); }
  .article-prose :global(.practice-timeline li:nth-child(6)) { --dot: hsl(var(--foreground)); }

  /* Rail segment from this dot down to the next card's dot. */
  .article-prose :global(.practice-timeline li:not(:last-child)::before) {
    content: "";
    position: absolute;
    left: calc(-1.75rem + 5px);
    top: 1.75rem;
    height: calc(100% + 0.75rem);
    width: 2px;
    background: hsl(var(--brand-blue-100));
  }

  .article-prose :global(.practice-timeline li::after) {
    content: "";
    position: absolute;
    left: -1.75rem;
    top: 1.5rem;
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: var(--dot);
    box-shadow: 0 0 0 4px hsl(var(--brand-beige));
  }

  .article-prose :global(.practice-timeline h3) {
    margin: 0 0 1rem;
    font-size: 1.375rem;
  }

  .article-prose :global(.practice-timeline p) {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .article-prose :global(.practice-timeline .pt-cols) {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .article-prose :global(.practice-timeline .pt-label) {
    margin-bottom: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .article-prose :global(.practice-timeline .pt-brain) {
    padding: 0.875rem 1rem;
    background: hsl(var(--brand-blue-light));
    border-radius: var(--radius);
  }

  .article-prose :global(.practice-timeline .pt-brain .pt-label) {
    color: hsl(var(--brand-blue-dark));
  }

  /* The link sits in an uppercase label; keep the tooltip in normal case. */
  .article-prose :global(.practice-timeline a.citation::after) {
    text-transform: none;
    letter-spacing: normal;
  }

  .article-prose :global(.practice-timeline figcaption) {
    margin: 0.875rem 0 0 1.75rem;
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }

  @media (min-width: 640px) {
    .article-prose :global(.practice-timeline li) {
      margin-left: 2.25rem;
      padding: 1.5rem;
    }

    .article-prose :global(.practice-timeline li:not(:last-child)::before) {
      left: calc(-2.25rem + 5px);
      top: 1.95rem;
    }

    .article-prose :global(.practice-timeline li::after) {
      left: -2.25rem;
      top: 1.75rem;
    }

    .article-prose :global(.practice-timeline .pt-cols) {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .article-prose :global(.practice-timeline figcaption) {
      margin-left: 2.25rem;
    }
  }
</style>
