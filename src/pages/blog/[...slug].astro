---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import { DownloadButtons } from "@/components/ui/DownloadButtons";
import QuizCTA, { type QuizCTAVariant } from "@/components/QuizCTA.astro";

// Tag → variant map (CONTENT.md §7 / SPEC.md Task 7). First matching tag
// in the post's own tag order wins; an unmapped-tag post falls back to
// `default`.
const TAG_VARIANTS: Record<string, QuizCTAVariant> = {
  "panic attacks": "panic",
  breathing: "anxiety",
  "nervous system": "anxiety",
  grounding: "anxiety",
  meditation: "sleep",
  habits: "sleep",
  calligraphy: "racingThoughts",
  focus: "racingThoughts",
};

function resolveQuizCTAVariant(postTags: string[]): QuizCTAVariant {
  for (const tag of postTags) {
    const variant = TAG_VARIANTS[tag];
    if (variant) return variant;
  }
  return "default";
}

export async function getStaticPaths() {
  const entries = await getCollection("blog", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  image,
  imageAlt,
  tags,
  authorName,
  authorBio,
} = entry.data;
const { Content } = await entry.render();

// dateModified defaults to the publish date when the post has never been edited.
const modifiedDate = updatedDate ?? pubDate;
// Byline avatar. Keep in sync with AUTHOR_IMAGE in src/pages/index.astro.
const authorImage = "/images/blog/blog_avatar_julia.webp";

const quizCTAVariant = resolveQuizCTAVariant(tags);

const pageTitle = `${title} — Calmisu`;
const canonicalUrl = new URL(`/blog/${entry.slug}/`, Astro.site).href;
const ogImage = image ?? "/images/calmisuog.png";
const absoluteImage = new URL(ogImage, Astro.site).href;

// Rough estimate from the raw markdown source — good enough for a "min read" hint.
const wordCount = entry.body.trim().split(/\s+/).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: modifiedDate.toISOString(),
  image: absoluteImage,
  author: {
    "@type": "Person",
    "@id": new URL("/#author", Astro.site).href,
    name: "Julia K",
    url: new URL("/about/", Astro.site).href,
    image: new URL("/images/blog/blog_avatar_julia.webp", Astro.site).href,
  },
  publisher: {
    "@type": "Organization",
    name: "Calmisu",
    url: new URL("/", Astro.site).href,
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", Astro.site).href,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
};
---

<BaseLayout
  title={pageTitle}
  description={description}
  ogImage={ogImage}
  ogType="article"
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
  </Fragment>

  {
    /*
      JSON-LD sits in <body>; Google's structured-data parser accepts it
      regardless of location.
    */
  }
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="flex flex-col items-center w-full bg-brand-beige overflow-hidden">
    <Header />

    <div class="w-full flex flex-col items-center px-6 sm:px-8 pt-10 sm:pt-14 pb-16 sm:pb-20">
      <div class="w-full max-w-[760px]">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 text-foreground font-body text-sm font-semibold no-underline hover:text-brand transition-colors mb-8"
        >
          &larr; All posts
        </a>

        <div class="flex flex-wrap items-center gap-3 mb-4">
          {tags[0] && (
            <span class="text-brand font-body text-xs px-3 py-1 rounded-full bg-brand-100">
              {tags[0]}
            </span>
          )}
          <span class="text-muted-foreground font-body text-sm">
            {readMinutes} min read
          </span>
        </div>

        <h1 class="text-foreground font-display text-4xl sm:text-5xl md:text-6xl font-normal leading-[105%] mb-6">
          {title}
        </h1>

        <time
          datetime={pubDate.toISOString()}
          class="block text-muted-foreground font-body text-sm"
        >
          {dateFormatter.format(pubDate)}
          {updatedDate && ` (updated ${dateFormatter.format(updatedDate)})`}
        </time>

        <a
          href="/about/"
          class="mt-5 inline-flex items-center gap-3 no-underline group w-fit"
          rel="author"
        >
          <img
            src={authorImage}
            alt={authorName}
            width="36"
            height="36"
            loading="lazy"
            class="h-9 w-9 rounded-full object-cover bg-brand-100"
          />
          <span class="flex flex-col leading-tight">
            <span class="text-foreground font-body text-sm font-semibold group-hover:text-brand transition-colors">
              {authorName}
            </span>
            <span class="text-muted-foreground font-body text-xs">
              {authorBio}
            </span>
          </span>
        </a>
      </div>
    </div>

    <main class="w-full flex flex-col items-center px-6 sm:px-8 py-12 sm:py-16">
      <article class="flex flex-col gap-10 w-full max-w-[760px]">
        <div class="relative w-full aspect-[16/8] rounded-2xl overflow-hidden bg-muted -mt-16 sm:-mt-20">
          {image && (
            <img
              src={image}
              alt={imageAlt ?? ""}
              class="w-full h-full object-cover"
            />
          )}
        </div>

        <div class="article-prose prose max-w-none">
          <Content />
        </div>

        <QuizCTA variant={quizCTAVariant} src={`blog_${entry.slug}`} />

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 rounded-3xl bg-brand-100 p-8 sm:p-10">
          <div class="flex flex-col gap-2">
            <p class="text-foreground font-display text-xl sm:text-2xl font-normal leading-[120%]">
              Find your center with Calmisu.
            </p>
            <p class="text-muted-foreground font-body text-sm sm:text-base max-w-[380px]">
              Guided breathing, grounding, calligraphy, and meditation — free
              to download.
            </p>
          </div>
          <DownloadButtons
            client:load
            only="android"
            location="blog_cta"
            widthClass="w-full sm:w-auto"
            className="shrink-0"
          />
        </div>
      </article>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  /*
   * @tailwindcss/typography is a devDependency but is NOT currently
   * registered in tailwind.config.ts (owned by task-01/task-06), so the
   * `prose` class above has no effect yet. This scoped stylesheet gives
   * article bodies correct brand typography and a readable measure
   * independent of that plugin. If the plugin is registered later, these
   * rules layer on top harmlessly.
   */
  .article-prose {
    color: hsl(var(--foreground));
    font-family: "Roboto", sans-serif;
    font-weight: 300;
    line-height: 1.7;
    font-size: 1.0625rem;
  }

  .article-prose :global(h2) {
    font-family: "Orienta", sans-serif;
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.2;
    color: hsl(var(--foreground));
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .article-prose :global(h3) {
    font-family: "Orienta", sans-serif;
    font-weight: 400;
    font-size: 1.375rem;
    line-height: 1.25;
    color: hsl(var(--foreground));
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .article-prose :global(p) {
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin-top: 0;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-prose :global(ul) {
    list-style-type: disc;
  }

  .article-prose :global(ol) {
    list-style-type: decimal;
  }

  .article-prose :global(li) {
    padding-left: 0.25rem;
  }

  .article-prose :global(li > p) {
    margin-bottom: 0;
  }

  .article-prose :global(strong) {
    font-weight: 500;
    color: hsl(var(--foreground));
  }

  .article-prose :global(a) {
    color: hsl(var(--brand-blue));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-prose :global(a:hover) {
    opacity: 0.85;
  }
</style>
