---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer";
import TagPill from "@/components/blog/TagPill.astro";
import PostCard from "@/components/blog/PostCard.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured] = posts;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const readMinutes = featured
  ? Math.max(1, Math.round(featured.body.trim().split(/\s+/).length / 200))
  : 0;
---

<BaseLayout
  title="Blog — Calmisu"
  description="Practical, calm guidance on breathing, grounding, and anxiety relief from the Calmisu team."
>
  <div class="flex flex-col items-center w-full bg-brand-beige overflow-hidden">
    <Header />

    <main class="w-full flex flex-col items-center px-6 sm:px-8 md:px-[140px] py-16 sm:py-20 md:py-24">
      <h1 class="text-foreground font-display text-4xl sm:text-5xl md:text-6xl font-normal leading-[100%] w-full max-w-[1160px] mb-10 md:mb-14">
        Blog
      </h1>

      {
        posts.length === 0 ? (
          <p class="text-muted-foreground font-body text-base font-light leading-[150%]">
            No posts yet — check back soon.
          </p>
        ) : (
          <div class="w-full max-w-[1160px] flex flex-col gap-14 md:gap-16">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center">
              <a
                href={`/blog/${featured.slug}/`}
                class="group block relative w-full aspect-[16/10] rounded-2xl overflow-hidden bg-muted no-underline"
              >
                {featured.data.image && (
                  <img
                    src={featured.data.image}
                    alt={featured.data.imageAlt ?? ""}
                    class="w-full h-full object-cover hover:scale-095 transition-transform duration-500 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                )}
              </a>
              <div class="flex flex-col gap-4">
                <div class="flex flex-wrap items-center gap-3">
                  {featured.data.tags[0] && <TagPill>{featured.data.tags[0]}</TagPill>}
                  <span class="text-muted-foreground font-body text-sm">
                    {readMinutes} min read
                  </span>
                  <span class="text-muted-foreground font-body text-sm">
                    {dateFormatter.format(featured.data.pubDate)}
                  </span>
                </div>
                <a href={`/blog/${featured.slug}/`} class="no-underline">
                  <h2 class="text-foreground font-display text-3xl sm:text-4xl font-normal leading-[120%] hover:text-brand transition-colors">
                    {featured.data.title}
                  </h2>
                </a>
                <p class="text-foreground font-body text-base font-light leading-[150%]">
                  {featured.data.description}
                </p>
                <a
                  href={`/blog/${featured.slug}/`}
                  class="w-fit text-foreground font-body text-base hover:text-brand transition-colors"
                >
                  Read more
                </a>
              </div>
            </div>

            {posts.length > 0 && (
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-10 list-none p-0 m-0">
                {posts.slice(1, posts.length).map((post) => (
                  <li>
                    <PostCard post={post} headingTag="h2" />
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </main>

    <Footer />
  </div>
</BaseLayout>



