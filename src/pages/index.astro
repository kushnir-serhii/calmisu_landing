---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import HeroSection from "@/components/HeroSection";
import AnimatedSection from "@/components/AnimatedSection";
import FeaturesFlow from "@/components/FeaturesFlow";
import FeaturesScience from "@/components/FeaturesScience";
import AnimatedChatSection from "@/components/AnimatedChatSection";
import AnimatedFAQSection from "@/components/AnimatedFAQSection";
import AnimatedCTASection from "@/components/AnimatedCTASection";
import Footer from "@/components/Footer";
import LatestPosts from "@/components/LatestPosts.astro";
import { faqItems } from "@/data/faq";

const PLAY_URL =
  "https://play.google.com/store/apps/details?id=com.calmisu.app";
const site = Astro.site ?? new URL("https://calmisu.com");

// YouTube channel for the entity graph (`sameAs` on Person + Organization).
// Resolved from https://youtu.be/27xEzkqhZE0 via oEmbed (channel "Calmisu").
const YOUTUBE_URL: string | null = "https://www.youtube.com/@Calmisu";

// Author photo for the Person node (also used as the blog byline avatar).
const AUTHOR_IMAGE: string | null = "/images/blog/blog_avatar_julia.webp";

const orgSameAs = [
  "https://www.instagram.com/calmisu.app/",
  "https://www.facebook.com/calmisu",
  "https://www.tiktok.com/@calmisu.app",
  ...(YOUTUBE_URL ? [YOUTUBE_URL] : []),
];

/**
 * One @graph so the entities cross-reference each other.
 *
 * No aggregateRating: the app has no public ratings yet, and inventing one is
 * a manual-action risk. Add it here once Play shows a real score.
 */
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("/#organization", site).href,
      name: "Calmisu",
      url: site.href,
      logo: new URL("/favicon.svg", site).href,
      sameAs: orgSameAs,
      founder: { "@id": new URL("/#author", site).href },
    },
    {
      "@type": "Person",
      "@id": new URL("/#author", site).href,
      name: "Julia K",
      jobTitle: "Product Designer & Creator of Calmisu",
      url: new URL("/about/", site).href,
      ...(AUTHOR_IMAGE
        ? { image: new URL(AUTHOR_IMAGE, site).href }
        : {}),
      ...(YOUTUBE_URL ? { sameAs: [YOUTUBE_URL] } : {}),
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", site).href,
      url: site.href,
      name: "Calmisu",
      publisher: { "@id": new URL("/#organization", site).href },
      inLanguage: "en",
    },
    {
      "@type": "MobileApplication",
      "@id": new URL("/#app", site).href,
      name: "Calmisu: Calm Your Anxiety",
      applicationCategory: "HealthApplication",
      applicationSubCategory: "Mental wellness",
      operatingSystem: "Android",
      url: site.href,
      installUrl: PLAY_URL,
      downloadUrl: PLAY_URL,
      image: new URL("/images/calmisuog.png", site).href,
      description:
        "Calmisu eases anxiety with a structured calming flow: guided breathing, 5-sense grounding, mindful kanji calligraphy, and calming meditation sounds.",
      publisher: { "@id": new URL("/#organization", site).href },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      featureList: [
        "Guided breathing exercises",
        "5-sense grounding techniques",
        "Mindful kanji calligraphy",
        "Calming meditation music",
        "24/7 reflective AI chat",
      ],
    },
    {
      "@type": "FAQPage",
      "@id": new URL("/#faq", site).href,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title="Anxiety Relief App: Breathing & Calligraphy | Calmisu"
  description="Calm anxiety and panic with guided breathing, 5-sense grounding, mindful calligraphy and meditation sounds. Free Android app — no ads, no account needed."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="flex flex-col items-center w-full bg-background overflow-hidden">
    <Header client:load />
    <HeroSection client:load />

    <AnimatedSection client:visible delay={100}>
      <FeaturesFlow />
    </AnimatedSection>

    <AnimatedSection client:visible delay={150}>
      <FeaturesScience />
    </AnimatedSection>

    <!-- ReviewsSection stays omitted/commented out — do not re-enable -->

    <AnimatedChatSection client:visible delay={250} />

    <AnimatedFAQSection client:visible delay={300} />

    <AnimatedSection client:visible delay={325}>
      <LatestPosts />
    </AnimatedSection>

    <AnimatedCTASection client:visible delay={350} />

    <AnimatedSection client:visible delay={400}>
      <Footer />
    </AnimatedSection>
  </div>
</BaseLayout>
