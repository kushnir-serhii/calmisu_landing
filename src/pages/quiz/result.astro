---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer";
import AnimatedSection from "@/components/AnimatedSection";
import QuizResultIsland from "@/components/QuizResultIsland";

/**
 * Quiz result.
 *
 * Deindexed on purpose: the page is one template over an unbounded set of query
 * strings, so every combination would be a near-duplicate with no search value.
 * `noindexFollow` keeps crawlers moving through its links to /quiz/ and the
 * Play listing. The matching sitemap exclusion lives in astro.config.mjs — both
 * have to stay in sync, per the comment on that filter.
 *
 * Nothing is server-rendered from the params: this is a static build, so the
 * island reads `location.search` on the client. The heading below is generic
 * for that reason.
 */
---

<BaseLayout
  title="Your Calm Profile | Calmisu"
  description="Your anxiety pattern, the two techniques that suit it, and a 7-day plan."
  noindexFollow={true}
>
  <div class="flex flex-col items-center w-full bg-background overflow-hidden">
    <Header />

    <main class="flex flex-col items-center w-full">
      <section
        class="w-full px-6 sm:px-8 md:px-16 lg:px-[140px] pt-10 sm:pt-12 md:pt-16 pb-16 sm:pb-20 md:pb-[120px]"
      >
        <QuizResultIsland client:only="react" />
      </section>
    </main>

    <AnimatedSection client:visible delay={100}>
      <Footer />
    </AnimatedSection>
  </div>
</BaseLayout>
